# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` puis adapter les chemins à votre machine.
# ---------------------------------------------------------------------------

# Dossier surveillé : Thunderbird y dépose les .eml et les pièces jointes.
SOURCE_DIR=/home/moi/Mails/export

# Dossier d'arrivée : l'Inbox du coffre Obsidian.
DEST_DIR=/home/moi/Obsidian/MonCoffre/00-Inbox

# --- Exécution -------------------------------------------------------------
# cuda (GPU NVIDIA) ou cpu.
TORCH_DEVICE=cuda
# true = le conteneur reste actif et traite les nouveaux fichiers en continu.
WATCH=false
# Intervalle de scrutation en secondes (mode WATCH).
POLL_INTERVAL=30
# unless-stopped si vous voulez un service permanent au démarrage de Docker.
RESTART_POLICY=no

# --- Traitement ------------------------------------------------------------
# Langues Tesseract pour le fallback OCR.
OCR_LANGS=fra+eng
# Supprimer les fichiers source après une conversion réussie.
DELETE_AFTER=false
# Retraiter les fichiers déjà convertis (ignore le journal).
REPROCESS=false
# Extraire et convertir les pièces jointes contenues dans les .eml.
EXTRACT_ATTACHMENTS=true
# Sous-dossier de DEST_DIR recevant les notes de pièces jointes.
ATTACHMENTS_SUBDIR=attachments
# Taille maximale d'un fichier traité (Mo).
MAX_FILE_MB=200
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
